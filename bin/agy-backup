#!/data/data/com.termux/files/usr/bin/python3
import sys
import os

# Resolve realpath to support symlinked execution
real_file = os.path.realpath(__file__)
pkg_dir = os.path.dirname(os.path.dirname(real_file))
if pkg_dir not in sys.path:
    sys.path.insert(0, pkg_dir)

from agy_backup.cli import main

if __name__ == "__main__":
    main()
